# WAYFARER Travel Planner Environment Configuration
# Copy this file to .env.local for local development if needed.
# No secret keys are required for the base client-side MVP.

# Base URL for metadata and OpenGraph assets
NEXT_PUBLIC_APP_URL=https://wayfarer-travel.onrender.com

# Node and Port configuration for production hosting (Render sets PORT automatically)
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
